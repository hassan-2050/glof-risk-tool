# --- environments ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# --- generated ---
outputs/*
!outputs/.gitkeep
.determinism_check/

# --- large intermediates (pinned data IS committed; scratch is not) ---
data/scratch/
*.tif.aux.xml

# --- secrets: no key is needed on the reproduce path, but guard anyway ---
.env
.env.*
*.key
*.pem
credentials.json

# --- agent trace export: regenerate with tools/export_agent_traces.py ---
# The 19 MB raw transcript is a build artefact, not source. The exporter is
# committed; its output ships in the submission archive, not in git.
submission/agent_traces/raw/
submission/agent_traces/TRANSCRIPT.md
